{
  "name": "Refund Request approved",
  "description": "To the course's Instructor when a Platform Admin approves a Refund Request on their course. Email is opt-in: the default preference set leaves it off. Triggered by approveRefundRequest.",
  "steps": [
    {
      "type": "channel",
      "template": {
        "action_url": "{{ vars.app_url }}{{ data.path | escape }}",
        "markdown_body@": "in_app_feed_1/markdown_body.md"
      },
      "ref": "in_app_feed_1",
      "channel_type": "in_app_feed",
      "channel_key": "in-app"
    },
    {
      "type": "channel",
      "template": {
        "subject": "Refund approved — {{ data.course_title | escape }}",
        "settings": {
          "layout_key": "cadence",
          "attachment_key": "attachments"
        },
        "html_body@": "email_1/html_body.html"
      },
      "ref": "email_1",
      "channel_type": "email",
      "channel_key": "postmark"
    }
  ],
  "categories": [
    "refund-request-approved"
  ],
  "trigger_data_json_schema": {
    "properties": {
      "buyer_name": {
        "minLength": 1,
        "type": "string"
      },
      "course_title": {
        "minLength": 1,
        "type": "string"
      },
      "outcome": {
        "enum": [
          "enrollment_lost",
          "enrollment_kept",
          "seats_cancelled"
        ],
        "type": "string"
      },
      "path": {
        "pattern": "^/",
        "type": "string"
      },
      "seats_cancelled": {
        "minimum": 1,
        "type": "integer"
      }
    },
    "required": [
      "course_title",
      "path",
      "buyer_name",
      "outcome"
    ],
    "type": "object"
  },
  "trigger_frequency": "every_trigger",
  "__readonly": {
    "key": "refund-request-approved",
    "active": true,
    "valid": true
  },
  "$schema": "https://schemas.knock.app/cli/workflow.json"
}
