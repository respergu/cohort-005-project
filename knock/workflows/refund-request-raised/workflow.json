{
  "name": "Refund Request raised",
  "description": "To every Platform Admin when a buyer raises a Refund Request. Triggered by raiseRefundRequest.",
  "steps": [
    {
      "type": "channel",
      "template": {
        "action_url": "{{ vars.app_url }}{{ data.path | escape }}",
        "markdown_body@": "in_app_feed_1/markdown_body.md"
      },
      "ref": "in_app_feed_1",
      "channel_type": "in_app_feed",
      "channel_key": "in-app"
    },
    {
      "type": "channel",
      "template": {
        "subject": "New refund request — {{ data.course_title | escape }}",
        "settings": {
          "layout_key": "cadence",
          "attachment_key": "attachments"
        },
        "html_body@": "email_1/html_body.html"
      },
      "ref": "email_1",
      "channel_type": "email",
      "channel_key": "postmark"
    }
  ],
  "categories": [
    "refund-request-raised"
  ],
  "trigger_data_json_schema": {
    "properties": {
      "buyer_name": {
        "minLength": 1,
        "type": "string"
      },
      "course_title": {
        "minLength": 1,
        "type": "string"
      },
      "path": {
        "pattern": "^/",
        "type": "string"
      },
      "reason": {
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "course_title",
      "path",
      "buyer_name",
      "reason"
    ],
    "type": "object"
  },
  "trigger_frequency": "every_trigger",
  "__readonly": {
    "key": "refund-request-raised",
    "active": true,
    "valid": true
  },
  "$schema": "https://schemas.knock.app/cli/workflow.json"
}
