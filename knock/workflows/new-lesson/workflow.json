{
  "name": "New lesson",
  "description": "To every Student with an Enrollment on a Published course when one of its lessons gets its first video. Batched per course for an hour, Notification Feed only, never email. Triggered by createLesson and updateLesson.",
  "categories": ["new-lesson"],
  "settings": {
    "override_preferences": false
  },
  "steps": [
    {
      "ref": "batch_1",
      "type": "batch",
      "settings": {
        "batch_key": "data.course_id",
        "batch_window_type": "fixed",
        "batch_window": {
          "unit": "hours",
          "value": 1
        },
        "batch_execution_mode": "accumulate",
        "batch_order": "asc",
        "workflow_version_mode": "latest"
      }
    },
    {
      "ref": "in_app_feed_1",
      "type": "channel",
      "channel_key": "in-app",
      "template": {
        "action_url": "{{ vars.app_url }}{{ data.path | escape }}",
        "markdown_body@": "in_app_feed_1/markdown_body.md"
      }
    }
  ],
  "trigger_data_json_schema": {
    "type": "object",
    "properties": {
      "course_title": {
        "type": "string",
        "minLength": 1
      },
      "path": {
        "type": "string",
        "pattern": "^/"
      },
      "course_id": {
        "type": "integer",
        "minimum": 1
      },
      "lesson_title": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": ["course_title", "path", "course_id", "lesson_title"]
  }
}
