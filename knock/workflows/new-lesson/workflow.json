{
  "name": "New lesson",
  "description": "To every Student with an Enrollment on a Published course when one of its lessons gets its first video. Batched per course for a minute, Notification Feed only, never email. Triggered by createLesson and updateLesson.",
  "steps": [
    {
      "type": "batch",
      "ref": "batch_1",
      "settings": {
        "batch_order": "asc",
        "batch_window_type": "fixed",
        "batch_key": "data.course_id",
        "batch_window": {
          "unit": "minutes",
          "value": 1
        },
        "batch_execution_mode": "accumulate",
        "workflow_version_mode": "latest"
      }
    },
    {
      "type": "channel",
      "template": {
        "action_url": "{{ vars.app_url }}{{ data.path | escape }}",
        "markdown_body@": "in_app_feed_1/markdown_body.md"
      },
      "ref": "in_app_feed_1",
      "channel_type": "in_app_feed",
      "channel_key": "in-app"
    }
  ],
  "categories": [
    "new-lesson"
  ],
  "trigger_data_json_schema": {
    "properties": {
      "course_id": {
        "minimum": 1,
        "type": "integer"
      },
      "course_title": {
        "minLength": 1,
        "type": "string"
      },
      "lesson_title": {
        "minLength": 1,
        "type": "string"
      },
      "path": {
        "pattern": "^/",
        "type": "string"
      }
    },
    "required": [
      "course_title",
      "path",
      "course_id",
      "lesson_title"
    ],
    "type": "object"
  },
  "trigger_frequency": "every_trigger",
  "__readonly": {
    "key": "new-lesson",
    "active": true,
    "valid": true
  },
  "$schema": "https://schemas.knock.app/cli/workflow.json"
}
