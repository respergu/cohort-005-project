{
  "name": "New Question",
  "description": "To the course's Instructor when anyone else asks a Question, batched per course for an hour. Triggered by createComment.",
  "categories": [
    "new-question"
  ],
  "settings": {
    "override_preferences": false
  },
  "steps": [
    {
      "ref": "batch_1",
      "type": "batch",
      "settings": {
        "batch_key": "data.course_id",
        "batch_window_type": "fixed",
        "batch_window": {
          "unit": "hours",
          "value": 1
        },
        "batch_execution_mode": "accumulate",
        "batch_order": "asc",
        "workflow_version_mode": "latest"
      }
    },
    {
      "ref": "in_app_feed_1",
      "type": "channel",
      "channel_key": "in-app",
      "template": {
        "action_url": "{{ vars.app_url }}{{ data.path | escape }}",
        "markdown_body@": "in_app_feed_1/markdown_body.md"
      }
    },
    {
      "ref": "email_1",
      "type": "channel",
      "channel_key": "postmark",
      "template": {
        "settings": {
          "layout_key": "cadence"
        },
        "subject": "{% if total_activities > 1 %}{{ total_activities }} new Questions{% else %}New Question{% endif %} — {{ data.course_title | escape }}",
        "html_body@": "email_1/html_body.html"
      }
    }
  ],
  "trigger_data_json_schema": {
    "type": "object",
    "properties": {
      "course_title": {
        "type": "string",
        "minLength": 1
      },
      "path": {
        "type": "string",
        "pattern": "^/"
      },
      "course_id": {
        "type": "integer"
      },
      "lesson_title": {
        "type": "string",
        "minLength": 1
      },
      "asker_name": {
        "type": "string",
        "minLength": 1
      },
      "question_excerpt": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "required": [
      "course_title",
      "path",
      "course_id",
      "lesson_title",
      "asker_name",
      "question_excerpt"
    ]
  }
}
