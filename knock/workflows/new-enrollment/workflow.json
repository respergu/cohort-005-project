{
  "name": "New Enrollment",
  "description": "To the course's Instructor when Students enrol, from Claimed Seats and Individual Purchases, batched per course for a minute. Email is opt-in: the default preference set turns it off for new-enrollment. Triggered by claimSeat and enrollUser.",
  "steps": [
    {
      "type": "batch",
      "ref": "batch_1",
      "settings": {
        "batch_order": "asc",
        "batch_window_type": "fixed",
        "batch_key": "data.course_id",
        "batch_window": {
          "unit": "minutes",
          "value": 1
        },
        "batch_execution_mode": "accumulate",
        "workflow_version_mode": "latest"
      }
    },
    {
      "type": "channel",
      "template": {
        "action_url": "{{ vars.app_url }}{{ data.path | escape }}",
        "markdown_body@": "in_app_feed_1/markdown_body.md"
      },
      "ref": "in_app_feed_1",
      "channel_type": "in_app_feed",
      "channel_key": "in-app"
    },
    {
      "type": "channel",
      "template": {
        "subject": "{% if total_actors > 1 %}{{ total_actors }} new Students{% else %}New Enrollment{% endif %} — {{ data.course_title | escape }}",
        "settings": {
          "layout_key": "cadence",
          "attachment_key": "attachments"
        },
        "html_body@": "email_1/html_body.html"
      },
      "ref": "email_1",
      "channel_type": "email",
      "channel_key": "postmark"
    }
  ],
  "categories": [
    "new-enrollment"
  ],
  "trigger_data_json_schema": {
    "properties": {
      "course_id": {
        "minimum": 1,
        "type": "integer"
      },
      "course_title": {
        "minLength": 1,
        "type": "string"
      },
      "path": {
        "pattern": "^/",
        "type": "string"
      }
    },
    "required": [
      "course_title",
      "path",
      "course_id"
    ],
    "type": "object"
  },
  "trigger_frequency": "every_trigger",
  "__readonly": {
    "key": "new-enrollment",
    "active": true,
    "valid": true
  },
  "$schema": "https://schemas.knock.app/cli/workflow.json"
}
