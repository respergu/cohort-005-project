{
  "name": "Refund Request decided",
  "description": "To the buyer when a Platform Admin approves or declines their Refund Request. Locked, because it's about the buyer's own money. Triggered by approveRefundRequest and declineRefundRequest.",
  "steps": [
    {
      "type": "channel",
      "template": {
        "action_url": "{{ vars.app_url }}{{ data.path | escape }}",
        "markdown_body@": "in_app_feed_1/markdown_body.md"
      },
      "ref": "in_app_feed_1",
      "channel_type": "in_app_feed",
      "channel_key": "in-app"
    },
    {
      "type": "channel",
      "template": {
        "subject": "Refund {{ data.decision | escape }} — {{ data.course_title | escape }}",
        "settings": {
          "layout_key": "cadence",
          "attachment_key": "attachments"
        },
        "html_body@": "email_1/html_body.html"
      },
      "ref": "email_1",
      "channel_type": "email",
      "channel_key": "postmark"
    }
  ],
  "settings": {
    "override_preferences": true,
    "is_commercial": false
  },
  "categories": [
    "refunds"
  ],
  "trigger_data_json_schema": {
    "properties": {
      "amount_paid": {
        "minLength": 1,
        "type": "string"
      },
      "course_title": {
        "minLength": 1,
        "type": "string"
      },
      "decision": {
        "enum": [
          "approved",
          "declined"
        ],
        "type": "string"
      },
      "note": {
        "minLength": 1,
        "type": "string"
      },
      "path": {
        "pattern": "^/",
        "type": "string"
      }
    },
    "required": [
      "course_title",
      "path",
      "decision",
      "amount_paid"
    ],
    "type": "object"
  },
  "trigger_frequency": "every_trigger",
  "__readonly": {
    "key": "refund-request-decided",
    "active": true,
    "valid": true
  },
  "$schema": "https://schemas.knock.app/cli/workflow.json"
}
