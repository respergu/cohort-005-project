{
  "name": "Seat claims",
  "description": "To the Team Admin when Students claim Seats on their Team Licence, batched per Team Licence for an hour. Branches on data.last_seat: Last Seat claimed (Feed and email) when the batch holds the final claim, otherwise Seat claimed (Feed only). Triggered by claimSeat.",
  "categories": [
    "seat-claims"
  ],
  "settings": {
    "override_preferences": false
  },
  "steps": [
    {
      "ref": "batch_1",
      "type": "batch",
      "settings": {
        "batch_key": "data.team_licence_id",
        "batch_window_type": "fixed",
        "batch_window": {
          "unit": "hours",
          "value": 1
        },
        "batch_execution_mode": "accumulate",
        "batch_order": "asc",
        "workflow_version_mode": "latest"
      }
    },
    {
      "ref": "branch_1",
      "type": "branch",
      "branches": [
        {
          "name": "Last Seat claimed",
          "conditions": {
            "all": [
              {
                "variable": "data.last_seat",
                "operator": "equal_to",
                "argument": "true"
              }
            ]
          },
          "steps": [
            {
              "ref": "in_app_feed_1",
              "type": "channel",
              "channel_key": "in-app",
              "template": {
                "action_url": "{{ vars.app_url }}{{ data.path | escape }}",
                "markdown_body@": "in_app_feed_1/markdown_body.md"
              }
            },
            {
              "ref": "email_1",
              "type": "channel",
              "channel_key": "postmark",
              "template": {
                "settings": {
                  "layout_key": "cadence"
                },
                "subject": "Last Seat claimed — {{ data.course_title | escape }}",
                "html_body@": "email_1/html_body.html"
              }
            }
          ],
          "terminates": false
        },
        {
          "name": "Seat claimed",
          "conditions": null,
          "steps": [
            {
              "ref": "in_app_feed_2",
              "type": "channel",
              "channel_key": "in-app",
              "template": {
                "action_url": "{{ vars.app_url }}{{ data.path | escape }}",
                "markdown_body@": "in_app_feed_2/markdown_body.md"
              }
            }
          ],
          "terminates": false
        }
      ]
    }
  ],
  "trigger_data_json_schema": {
    "type": "object",
    "properties": {
      "course_title": {
        "type": "string",
        "minLength": 1
      },
      "path": {
        "type": "string",
        "pattern": "^/"
      },
      "team_licence_id": {
        "type": "integer",
        "minimum": 1
      },
      "seats_left": {
        "type": "integer",
        "minimum": 0
      },
      "last_seat": {
        "type": "boolean",
        "enum": [
          true
        ]
      }
    },
    "required": [
      "course_title",
      "path",
      "team_licence_id",
      "seats_left"
    ]
  }
}
