{
  "name": "Seat claims",
  "description": "To the Team Admin when Students claim Seats on their Team Licence, batched per Team Licence for a minute. Branches on data.last_seat: Last Seat claimed (Feed and email) when the batch holds the final claim, otherwise Seat claimed (Feed only). Triggered by claimSeat.",
  "steps": [
    {
      "type": "batch",
      "ref": "batch_1",
      "settings": {
        "batch_order": "asc",
        "batch_window_type": "fixed",
        "batch_key": "data.team_licence_id",
        "batch_window": {
          "unit": "minutes",
          "value": 1
        },
        "batch_execution_mode": "accumulate",
        "workflow_version_mode": "latest"
      }
    },
    {
      "type": "branch",
      "ref": "branch_1",
      "branches": [
        {
          "name": "Last Seat claimed",
          "steps": [
            {
              "type": "channel",
              "template": {
                "action_url": "{{ vars.app_url }}{{ data.path | escape }}",
                "markdown_body@": "in_app_feed_1/markdown_body.md"
              },
              "ref": "in_app_feed_1",
              "channel_type": "in_app_feed",
              "channel_key": "in-app"
            },
            {
              "type": "channel",
              "template": {
                "subject": "Last Seat claimed — {{ data.course_title | escape }}",
                "settings": {
                  "layout_key": "cadence",
                  "attachment_key": "attachments"
                },
                "html_body@": "email_1/html_body.html"
              },
              "ref": "email_1",
              "channel_type": "email",
              "channel_key": "postmark"
            }
          ],
          "conditions": {
            "all": [
              {
                "variable": "data.last_seat",
                "operator": "equal_to",
                "argument": "true"
              }
            ]
          },
          "terminates": false
        },
        {
          "name": "Seat claimed",
          "steps": [
            {
              "type": "channel",
              "template": {
                "action_url": "{{ vars.app_url }}{{ data.path | escape }}",
                "markdown_body@": "in_app_feed_2/markdown_body.md"
              },
              "ref": "in_app_feed_2",
              "channel_type": "in_app_feed",
              "channel_key": "in-app"
            }
          ],
          "terminates": false
        }
      ]
    }
  ],
  "categories": [
    "seat-claims"
  ],
  "trigger_data_json_schema": {
    "properties": {
      "course_title": {
        "minLength": 1,
        "type": "string"
      },
      "last_seat": {
        "enum": [
          true
        ],
        "type": "boolean"
      },
      "path": {
        "pattern": "^/",
        "type": "string"
      },
      "seats_left": {
        "minimum": 0,
        "type": "integer"
      },
      "team_licence_id": {
        "minimum": 1,
        "type": "integer"
      }
    },
    "required": [
      "course_title",
      "path",
      "team_licence_id",
      "seats_left"
    ],
    "type": "object"
  },
  "trigger_frequency": "every_trigger",
  "__readonly": {
    "key": "seat-claimed",
    "active": true,
    "valid": true
  },
  "$schema": "https://schemas.knock.app/cli/workflow.json"
}
