{
  "name": "Reply",
  "description": "To a Question's author when someone else replies to it, while they have an Enrollment on the course. Triggered by createComment.",
  "categories": [
    "reply"
  ],
  "settings": {
    "override_preferences": false
  },
  "steps": [
    {
      "ref": "in_app_feed_1",
      "type": "channel",
      "channel_key": "in-app",
      "template": {
        "action_url": "{{ vars.app_url }}{{ data.path | escape }}",
        "markdown_body@": "in_app_feed_1/markdown_body.md"
      }
    },
    {
      "ref": "email_1",
      "type": "channel",
      "channel_key": "postmark",
      "template": {
        "settings": {
          "layout_key": "cadence"
        },
        "subject": "{{ data.replier_name | escape }} replied to your Question — {{ data.course_title | escape }}",
        "html_body@": "email_1/html_body.html"
      }
    }
  ],
  "trigger_data_json_schema": {
    "type": "object",
    "properties": {
      "course_title": {
        "type": "string",
        "minLength": 1
      },
      "path": {
        "type": "string",
        "pattern": "^/"
      },
      "lesson_title": {
        "type": "string",
        "minLength": 1
      },
      "replier_name": {
        "type": "string",
        "minLength": 1
      },
      "reply_excerpt": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "required": [
      "course_title",
      "path",
      "lesson_title",
      "replier_name",
      "reply_excerpt"
    ]
  }
}
